# ==========================================================
# 自建 Supabase 环境变量（复制到 /opt/supabase/.env 后逐项填写）
# 生成随机值：openssl rand -hex 32
# ==========================================================

############ 数据库 ############
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ JWT / API Keys ############
# JWT_SECRET 至少 32 字符；ANON_KEY 与 SERVICE_ROLE_KEY 必须用同一个 JWT_SECRET 签发
JWT_SECRET=<openssl rand -hex 32>
ANON_KEY=<用 JWT_SECRET 签发，role=anon，exp=10年>
SERVICE_ROLE_KEY=<用 JWT_SECRET 签发，role=service_role，exp=10年>

############ 对外地址 ############
SITE_URL=https://indoorplaygroundsolution.com
API_EXTERNAL_URL=https://api.indoorplaygroundsolution.com
SUPABASE_PUBLIC_URL=https://api.indoorplaygroundsolution.com
ADDITIONAL_REDIRECT_URLS=https://indoorplaygroundsolution.com/**

############ Studio 后台 ############
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<强密码>
STUDIO_DEFAULT_ORGANIZATION=Ninescapeland
STUDIO_DEFAULT_PROJECT=indoorplaygroundsolution

############ Auth ############
# 禁止公开注册：后台账号只由 create-admin 函数创建
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
JWT_EXPIRY=3600

############ SMTP（找回密码 / 邮箱验证）############
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=<企业邮箱账号>
SMTP_PASS=<企业邮箱密码>
SMTP_SENDER_NAME=Ninescapeland
SMTP_ADMIN_EMAIL=<企业邮箱账号>

############ Storage ############
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800
# 图片变换（前端用到 ?width= 参数），自建需开启 imgproxy
IMGPROXY_ENABLE_WEBP_DETECTION=true

############ Edge Functions 运行时（AI 函数用）############
# 当前线上用的是硅基流动，迁过来保持一致即可
AI_PROVIDER=siliconflow
SILICONFLOW_API_KEY=<硅基流动 Key>
# 备选：OPENAI_API_KEY= / DEEPSEEK_API_KEY=

############ 其它 ############
POOLER_TENANT_ID=indoorplayground
POOLER_DEFAULT_POOL_SIZE=20
SECRET_KEY_BASE=<openssl rand -hex 32>
VAULT_ENC_KEY=<openssl rand -hex 16>
LOGFLARE_PUBLIC_ACCESS_TOKEN=<openssl rand -hex 16>
LOGFLARE_PRIVATE_ACCESS_TOKEN=<openssl rand -hex 16>
